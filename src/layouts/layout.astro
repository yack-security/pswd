---
import '@/styles/global.css';

interface Props {
  description?: string;
  og?: string;
  title?: string;
}

const title = Astro.props.title
  ? `${Astro.props.title} — PSWD`
  : 'Simple Secure Password Generator';

const description =
  Astro.props.description || 'A simple and secure password generator.';

const og = Astro.props.og || '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <meta content="#18181b" name="theme-color" />

    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="PSWD" property="og:site_name" />
    <meta content="https://password.yack.one/" property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={`https://password.yack.one${og}`} property="og:image" />

    <link href="/sitemap-index.xml" rel="sitemap" />
  </head>
  <body>
    <div class="this-background">
      <slot />
    </div>
  </body>
</html>
