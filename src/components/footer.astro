---
import { Container } from './container';
---

<Container>
  <footer class="footer">
    <p>
      This project is a fork of: <a
        href="https://github.com/remvze/pswd"
        rel="noreferrer"
        target="_blank">pswd</a
      >.
    </p>
    <p>
      Made with ❤️ by <a
        href="https://yack.one"
        target="_blank"
        rel="noreferrer">Yack</a
      >.
    </p>
  </footer>
</Container>

<style>
  .footer {
    padding-bottom: 40px;
    text-align: center;

    & p {
      font-size: var(--font-sm);
      color: var(--color-foreground-subtle);

      &:not(:last-of-type) {
        margin-bottom: 8px;
      }

      & a {
        font-weight: 500;
        color: var(--color-foreground);
        text-decoration: none;
      }
    }
  }
</style>
